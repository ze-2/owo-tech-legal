# OpenAI-compatible text generation for structured extraction, conversational
# interpretation and research drafting. Server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# The default is a free model, which is enough to exercise the whole flow but is
# rate-limited and inconsistent. Prefer a paid model for real use. Models without
# structured-output support still work — the field contract is also stated in the
# prompt and model output is normalised — but they drift more.
OPENAI_TEXT_MODEL=dots-studio/dots-3-note-preview:free
# Override the API endpoint. Defaults to OpenRouter; set to
# https://api.openai.com/v1 for direct OpenAI access.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Exa is retrieval-only: official Judiciary source search for research.
# Server-only. Never prefix this with NEXT_PUBLIC_.
EXA_API_KEY=

# Server-only Whisper transcription via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
